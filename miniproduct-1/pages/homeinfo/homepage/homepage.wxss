/* pages/homepage/homepage.wxss */
/*
屏幕宽度750，
图片距左边100，距右边30
图片总宽度620，总高度620 * 0.618 = 383
图片部分宽310，图片部分搞191.5
*/
page{
  background-color: white;
}

.swiper-tab{
  width: 100%;
  line-height: 80rpx;
  padding-left: 20rpx;
}

.swiper-tab-list{  font-size: 30rpx;
  display: inline-block;
  width: 90rpx;
  color: #777777;
  text-align: center;
  margin-left: 20rpx;
}
.on{ 
  color: #333333;
  font-weight: 700;
  border-bottom: 6rpx solid #ffa500;
}

.swiper-box{ display: block; height: 100%; width: 100%; overflow: hidden; }
.swiper-item{
  height: 100%;
}

.swiper-box view{
  text-align: center;
}

.backview{
  background-color: white;
  width: 100vw;
  height: 100%;
}

.scroll-page{
  background-color: white;
  height: 100%;
}


/* .icon-size{
  width: 40rpx;
  height: 40rpx;
} */

.searchback {
  width: 100%;
  height: 100rpx;
  background-color: white;
  display: flex;
}

.searchview{
  background-color: #f5f5f5;
  margin: auto;
  height: 80rpx;
  width: 690rpx;
  border-radius: 40rpx;
  text-align: center;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
  color: #666;
}

.searchtext {
  margin-left: 16rpx;
}
