/* pages/TopicDetail/TopicDetail.wxss */

page{
  background-color: white;
}

.back-view{
  background-color: white;
  display: flex;
  flex-direction: column;
  width: 100vw;
  height: 100vh;
}

.scroll-page{
  background-color: white;
  padding-bottom: 200rpx;
}

.bottom-view{
  background-color: white;
  /* height: 200rpx; */
}

.userInfo{
  display: flex;
  flex-direction: row;
  height: 120rpx;
  width: 100%;
  padding-left: 20rpx;
  align-items: center;
}
.empty-head{
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background-color: #f5f5f5;
}
.head-img{
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background-color: #f5f5f5;
}

.userName{
  display: flex;
  flex-direction: column;
  color: #000;
  font-size: 32rpx;
  padding-left: 20rpx;
  flex-grow: 1;
  align-items: flex-start;
}

.time-item{
  font-size: 24rpx;
  color: #707070;
}

.icon-view{
  width: 60rpx;
  height: 60rpx;
  padding-right: 60rpx;
  flex-grow: 0;
}

.tag-content{
  display: flex;
  flex-direction: row;
  width: 100vw;
  flex-wrap: wrap;
  justify-content: flex-start;
  padding-left: 30rpx;
  padding-right: 30rpx;
  margin-bottom: 10rpx;
}

.tags {
  background-color: #ffa500;
  width: max-content;
  padding-left: 10rpx;
  padding-right: 10rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
  font-size: 26rpx;
  color:white;
}


.content{
  font-size: 32rpx;
  color: #333;
  padding-left: 30rpx;
  padding-right: 30rpx;
  text-align: left;
}

.image-content{
  padding-left: 30rpx;
  padding-right: 30rpx;
  margin-top: 10rpx;
  margin-bottom: 10rpx;
}

.topic-img{
  width: 100%;
}
.contact-view{
  height: 90rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}
.interaction{
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding-left: 30rpx;
  padding-right: 30rpx;
}

.mini-btn{
  font-size: 26rpx;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items:center;
  text-align: center;
  color:#777777;
  width: 230rpx;
}

.interaction > .mini-btn {
  flex: 1;
  min-width: 0;
}

.interaction > .mini-btn > .mini-btn {
  width: 100%;
}

.com-img{
  height: 120rpx;
  width: 120rpx;
  padding-right: 20rpx;
  flex-grow: 0;
}

/* 领养须知 / 申请状态弹窗 */
.dialog-mask{
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(0, 0, 0, 0.45);
}

.dialog-box{
  width: 610rpx;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  background-color: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
}

.dialog-title{
  padding: 36rpx 30rpx 20rpx;
  font-size: 34rpx;
  color: #333333;
  text-align: center;
}

.dialog-content{
  max-height: 50vh;
  padding: 0 36rpx 20rpx;
  font-size: 28rpx;
  line-height: 46rpx;
  color: #333333;
}

.dialog-message{
  white-space: pre-wrap;
}

.dialog-link{
  margin-top: 20rpx;
  color: #4169E1;
  font-size: 28rpx;
}

.dialog-actions{
  display: flex;
  flex-direction: row;
  border-top: 1rpx solid #ededed;
}

.dialog-actions-column{
  flex-direction: column;
}

.dialog-btn{
  flex: 1;
  padding: 26rpx 0;
  text-align: center;
  font-size: 30rpx;
  color: #666666;
}

.dialog-actions-column .dialog-btn{
  border-top: 1rpx solid #ededed;
}

.dialog-actions-column .dialog-btn:first-child{
  border-top: none;
}

.dialog-btn-primary{
  color: #ffa500;
}

.dialog-actions-row .dialog-btn + .dialog-btn{
  border-left: 1rpx solid #ededed;
}