/* pages/adoption/profile/profile.wxss */
page {
  background-color: #ffffff;
}

.back-view {
  width: 100vw;
  height: 100vh;
  background-color: #ffffff;
}

.scroll-view {
  height: 100%;
}

.loading-view {
  padding-top: 200rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8b8b8b;
}

.form-cell {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 100rpx;
  margin-left: 30rpx;
  padding-right: 30rpx;
  border-bottom: 1rpx solid #ededed;
  box-sizing: border-box;
}

.form-label {
  width: 210rpx;
  font-size: 30rpx;
  color: #333333;
}

.form-value {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
  text-align: right;
}

.form-value.placeholder {
  color: #8b8b8b;
}

.form-arrow {
  width: 16rpx;
  height: 16rpx;
  margin-left: 12rpx;
  border-top: 3rpx solid #c7c7cc;
  border-right: 3rpx solid #c7c7cc;
  transform: rotate(45deg);
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  height: 100rpx;
  font-size: 30rpx;
  color: #333333;
  text-align: right;
}

.form-cell-textarea {
  flex-direction: column;
  align-items: flex-start;
  padding-top: 26rpx;
  padding-bottom: 20rpx;
}

.form-textarea {
  width: 100%;
  height: 220rpx;
  margin-top: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 42rpx;
  color: #333333;
  background-color: #f7f7f7;
  border-radius: 10rpx;
}

.word-count {
  width: 100%;
  margin-top: 10rpx;
  text-align: right;
  font-size: 24rpx;
  color: #8b8b8b;
}

.save-btn {
  width: 690rpx;
  height: 85rpx;
  line-height: 85rpx;
  margin: 60rpx auto 40rpx;
  padding: 0;
  font-size: 32rpx;
  color: #ffffff;
  background-color: #ffa500;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.save-btn[disabled] {
  color: #ffffff;
  background-color: #ffd28a;
}
