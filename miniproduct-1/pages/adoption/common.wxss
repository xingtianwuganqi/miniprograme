/* pages/adoption/common.wxss */
page {
  background-color: #f5f5f5;
}

.page {
  display: flex;
  flex-direction: column;
  width: 100vw;
  height: 100vh;
  background-color: #f5f5f5;
}

.filter-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 20rpx;
  background-color: #ffffff;
}

.filter-item {
  flex: 1;
  height: 64rpx;
  margin: 0 6rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666666;
  background-color: #f5f5f5;
  border-radius: 32rpx;
}

.filter-item.active {
  color: #ffffff;
  background-color: #ffa500;
}

.scroll-page {
  flex: 1;
  height: 0;
}

.notice-section {
  margin: 20rpx;
  padding: 0 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
}

.section-title {
  padding: 24rpx 0 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.notice-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 20rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.notice-dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 12rpx;
  margin-right: 12rpx;
  border-radius: 6rpx;
  background-color: #ff3b30;
  flex-shrink: 0;
}

.notice-message {
  flex: 1;
  font-size: 28rpx;
  line-height: 40rpx;
  color: #333333;
}

.notice-time {
  margin-left: 16rpx;
  font-size: 22rpx;
  line-height: 40rpx;
  color: #8b8b8b;
  flex-shrink: 0;
}

.card {
  margin: 20rpx;
  padding: 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
}

.card-header {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.badge {
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.badge-applying {
  color: #ff9500;
  background-color: #fff2df;
}

.badge-communicating {
  color: #34a853;
  background-color: #e8f7ed;
}

.badge-ended {
  color: #8b8b8b;
  background-color: #f0f0f0;
}

.time {
  margin-left: auto;
  font-size: 24rpx;
  color: #8b8b8b;
}

.status-note {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #8b8b8b;
}

.topic {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 20rpx;
  padding: 16rpx;
  background-color: #f7f7f7;
  border-radius: 12rpx;
}

.topic-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
  background-color: #e5e5e5;
  flex-shrink: 0;
}

.topic-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #8b8b8b;
}

.topic-desc {
  flex: 1;
  margin-left: 20rpx;
  font-size: 28rpx;
  line-height: 40rpx;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.arrow {
  width: 16rpx;
  height: 25rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.contact-panel {
  margin-top: 20rpx;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
}

.contact-panel.has-contact {
  background-color: #e9f7ee;
}

.contact-title {
  font-size: 24rpx;
  color: #8b8b8b;
}

.contact-value {
  margin-top: 8rpx;
  font-size: 30rpx;
  line-height: 42rpx;
  color: #333333;
  word-break: break-all;
}

.contact-panel.has-contact .contact-value {
  color: #1f8f4a;
  font-weight: 700;
}

.actions {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.btn {
  margin-left: 16rpx;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  color: #666666;
  background-color: #ffffff;
  border: 1rpx solid #d9d9d9;
  border-radius: 12rpx;
}

.btn.primary {
  color: #ffffff;
  background-color: #ffa500;
  border-color: #ffa500;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background-color: #eeeeee;
  flex-shrink: 0;
}

.identity {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.profile-panel {
  margin-top: 20rpx;
  padding: 20rpx;
  background-color: #f7f7f7;
  border-radius: 12rpx;
}

.profile-title {
  font-size: 24rpx;
  color: #8b8b8b;
}

.profile-summary {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 42rpx;
  color: #333333;
  white-space: pre-wrap;
}

.divider {
  height: 1rpx;
  margin-top: 20rpx;
  background-color: #e5e5e5;
}

.list-footer {
  padding: 30rpx 0 50rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8b8b8b;
}

.dialog-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(0, 0, 0, 0.45);
}

.dialog-box {
  width: 610rpx;
  padding: 36rpx 36rpx 0;
  box-sizing: border-box;
  background-color: #ffffff;
  border-radius: 20rpx;
}

.dialog-title {
  font-size: 34rpx;
  color: #333333;
  text-align: center;
}

.dialog-message {
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  color: #666666;
}

.dialog-textarea {
  width: 100%;
  height: 180rpx;
  margin-top: 20rpx;
  padding: 18rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 40rpx;
  color: #333333;
  background-color: #f7f7f7;
  border-radius: 10rpx;
}

.dialog-count {
  margin-top: 8rpx;
  text-align: right;
  font-size: 22rpx;
  color: #8b8b8b;
}

.dialog-actions {
  display: flex;
  flex-direction: row;
  margin: 20rpx -36rpx 0;
  border-top: 1rpx solid #ededed;
}

.dialog-btn {
  flex: 1;
  padding: 26rpx 0;
  text-align: center;
  font-size: 30rpx;
  color: #666666;
}

.dialog-btn + .dialog-btn {
  border-left: 1rpx solid #ededed;
}

.dialog-btn-primary {
  color: #ffa500;
  font-weight: 600;
}
