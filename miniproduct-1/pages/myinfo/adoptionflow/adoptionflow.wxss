/* pages/myinfo/adoptionflow/adoptionflow.wxss */
page {
  background-color: #f5f8f6;
  color: #24332c;
}

.flow-page {
  padding: 28rpx 20rpx 60rpx;
  box-sizing: border-box;
}

.flow-header {
  margin-bottom: 48rpx;
}

.brand {
  color: #25835d;
  font-size: 24rpx;
  letter-spacing: 4rpx;
}

.title {
  margin-top: 16rpx;
  font-size: 54rpx;
  line-height: 1.35;
  font-weight: 600;
  color: #24332c;
}

.lead {
  margin-top: 20rpx;
  font-size: 30rpx;
  line-height: 1.75;
  color: #66756e;
}

.section {
  margin: 32rpx 0;
  padding: 40rpx;
  background-color: #ffffff;
  border: 1rpx solid #dde8e1;
  border-radius: 32rpx;
}

.section-title {
  margin-bottom: 24rpx;
  font-size: 36rpx;
  line-height: 1.4;
  font-weight: 600;
  color: #24332c;
}

.flow-item {
  padding: 24rpx 28rpx;
  background-color: #fbfdfb;
  border: 1rpx solid #dde8e1;
  border-radius: 24rpx;
}

.flow-item.finish {
  background-color: #edf7f0;
  border-color: #b5d9c3;
}

.flow-title {
  font-size: 32rpx;
  line-height: 1.5;
  font-weight: 600;
  color: #24332c;
}

.flow-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: #66756e;
}

.flow-arrow {
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 40rpx;
  color: #25835d;
}

.step {
  margin-top: 32rpx;
}

.step.first {
  margin-top: 0;
}

.step-title {
  font-size: 32rpx;
  line-height: 1.5;
  font-weight: 600;
  color: #24332c;
}

.step-desc,
.paragraph {
  margin-top: 8rpx;
  font-size: 30rpx;
  line-height: 1.75;
  color: #66756e;
}

.note {
  margin-top: 24rpx;
  padding-left: 24rpx;
  border-left: 6rpx solid #25835d;
  font-size: 28rpx;
  line-height: 1.75;
  color: #66756e;
}

.status-item {
  margin-top: 24rpx;
}

.status-item.first {
  margin-top: 0;
}

.badge {
  display: inline-block;
  padding: 2rpx 18rpx;
  border-radius: 32rpx;
  background-color: #edf7f0;
  color: #25835d;
  font-size: 24rpx;
  font-weight: 600;
}

.status-desc {
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.75;
  color: #66756e;
}

.tip-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-top: 16rpx;
}

.tip-item.first {
  margin-top: 0;
}

.tip-dot {
  width: 10rpx;
  height: 10rpx;
  margin-top: 18rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background-color: #25835d;
  flex-shrink: 0;
}

.tip-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.75;
  color: #66756e;
}

.footer {
  margin-top: 48rpx;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.6;
  color: #66756e;
}
